{% if data.action_items %}
## Action Items

{% for item in data.action_items %}
{% if item.text.strip() %}
- [ ] {{ item.owner + ': ' if item.owner else '' }}{{ item.text.strip() }}
{% endif %}
{% endfor %}

{% endif %}
{% if data.requirements %}
## Requirements

{% for req in data.requirements %}
