{% if transcript and transcript.segments %}
## Full Transcript

{% set ns = namespace(order=[], grouped={}) %}
{% for seg in transcript.segments %}
{% if seg.text.strip() %}
{% if seg.speaker not in ns.grouped %}
{% set _ = ns.order.append(seg.speaker) %}
{% set _ = ns.grouped.update({seg.speaker: [seg.text.strip()]}) %}
{% else %}
{% set _ = ns.grouped[seg.speaker].append(seg.text.strip()) %}
{% endif %}
{% endif %}
{% endfor %}
{% for speaker in ns.order %}
### {{ speaker }}

{% for text in ns.grouped[speaker] %}
{{ text }}

{% endfor %}
{% endfor %}
{% endif %}
